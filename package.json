{
  "name": "shebelieves-preview",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Independent single-page website concept for the SheBelieves.pk Twin Cities women's community.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/check.mjs",
    "check:dist": "node scripts/check.mjs --dist",
    "verify": "npm run check && npm run build && npm run check:dist"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  },
  "devDependencies": {
    "node-html-parser": "^7.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
